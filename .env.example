ENV=dev

# Postgres credentials (used by both the api and db services)
POSTGRES_USER=gb
POSTGRES_PASSWORD=gb
POSTGRES_DB=gb

# DB URL for the api container (host = service name in docker-compose)
DATABASE_URL=postgresql+asyncpg://gb:gb@db:5432/gb

# Google Workspace (for Gmail via domain-wide delegation)
WORKSPACE_DOMAIN=tobiaseek.com
# Path INSIDE the container — secrets/ is mounted to /app/secrets read-only
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/gcp-service-account.json

# Comma-separated list of internal emails or bare domains. Contacts matching
# these are NOT created in the Notion Contacts DB (they're "us", not "them").
# Example: "tobias@tobiaseek.com, post@tobiaseek.com, tobiaseek.com"
INTERNAL_EMAILS_OR_DOMAINS=tobiaseek.com

# Notion integration token (starts with ntn_)
NOTION_TOKEN=
NOTION_API_VERSION=2022-06-28

# Notion database IDs — hit /debug/databases once the integration is shared with
# the Emails and Contacts databases, then paste the IDs here.
EMAILS_DB_ID=
CONTACTS_DB_ID=
# Optional: scope the Notion webhook to pages added to this specific database.
# Leave empty to act on every page.created event the integration sees.
PROJECTS_DB_ID=

# Cloudflare Tunnel token (from Cloudflare Zero Trust → Networks → Tunnels).
# Long string starting with "eyJ...". Empty value disables the cloudflared
# service — useful for purely-local dev without a public URL.
CLOUDFLARE_TUNNEL_TOKEN=

# Notion webhook verification token. Notion sends this once when you register
# the webhook URL — paste it here to enable signature checks.
NOTION_WEBHOOK_SECRET=

# Gmail Pub/Sub push (Stage 4c)
# Full topic name, e.g. projects/gb-automations-dev-XYZ/topics/gmail-events
PUBSUB_TOPIC=
# Audience claim Pub/Sub signs JWTs with — must match what's configured on the
# push subscription (default: the endpoint URL).
PUBSUB_AUDIENCE=https://hub.tobiaseek.com/webhooks/gmail
# Email of the service account chosen when creating the push subscription
PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Local LLM (Ollama) — runs in the `ollama` compose service.
# On Mac dev with Ollama installed natively on host, override the base URL:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT_S=30.0

# LLM auto-tagging on each synced email row. ON by default. Tagging adds ~1-2s
# per Notion row (one classify call against Ollama). The taxonomy is in
# config.py::EMAIL_TAGS and mixes communication-type (tilbud, korreksjon, …)
# with topic/aspect (kjøkken, fasade, …). Set to false to disable.
TAGGING_ENABLED=true

# Logging. Default INFO shows the narrative story of each webhook (received →
# decisions → outcome). Set DEBUG to also see every outbound Notion/Gmail API
# call as one-line records — useful when sync goes wrong and you want to know
# exactly which API call broke.
LOG_LEVEL=INFO
