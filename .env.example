# gb-automations — copy to .env, fill in the blanks.
#
# Guides (read these while filling this in):
#   docs/guide.md               THE entrypoint — the short fresh-deploy checklist
#   docs/misc/google-setup.md   GCP project, service account, Gmail Pub/Sub push
#   docs/misc/cloudflare-setup.md  public tunnel
#   docs/misc/notion-setup.md   integration token + DB ids + the Notion buttons
#   docs/misc/nas-setup.md      office NAS (optional)
#   docs/misc/frame-setup.md    Frame.io OAuth + webhook (optional)
#   docs/misc/fiken-integration.md  Fiken accounting (optional)
#
# The Gmail↔Notion core (the first "Fill In" blocks) is what has to be populated
# for the stack to do anything useful. Frame / Toggl / Fiken are each
# independently gated behind a SYNC_* flag that defaults to false — leave a whole
# block blank until you're wiring that integration up.

# --- Stack basics (leave as-is) ---
ENV=dev
LOG_LEVEL=INFO
POSTGRES_USER=gb
POSTGRES_PASSWORD=gb
POSTGRES_DB=gb
DATABASE_URL=postgresql+asyncpg://gb:gb@db:5432/gb

# --- LLM ---
# OLLAMA_BASE_URL: where the api talks to Ollama. NOTE: docker-compose.yml
# OVERRIDES this to http://host.docker.internal:11434, because Ollama always
# runs NATIVELY on the host (Mac/Windows) for hardware acceleration — never in
# a container. This value here is the fallback used when running the app OUTSIDE
# Docker (e.g. `uv run`). You normally don't need to touch it.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT_S=300.0
TAGGING_ENABLED=true
# Per-deployment tagging prompt. Goldbox ships prompts/goldbox.md; the generic
# fallback is prompts/default.md.
TAGGING_PROMPT_PATH=prompts/default.md


# =================================================================== #
# ----------------------------- Fill In ----------------------------- #
# =================================================================== #


# --- Workspace + Gmail (via service-account domain-wide delegation) ---
# WORKSPACE_DOMAIN — your Google Workspace primary domain, e.g. goldbox.no.
# SYNCED_MAILBOXES — comma-separated mailboxes the backend syncs. THIS IS THE
#   SOURCE OF TRUTH for the users table: on startup the app reconciles the
#   `users` table to exactly match this list (listed → active, others →
#   inactive). Edit + `docker compose up -d --force-recreate api` to change it.
#   e.g. SYNCED_MAILBOXES=petter@goldbox.no,anna@goldbox.no
# INTERNAL_EMAILS_OR_DOMAINS — comma-separated addresses/domains treated as
#   "internal" when classifying email participants (e.g. goldbox.no).
# GOOGLE_SERVICE_ACCOUNT_JSON — path INSIDE the container to the SA key file.
#   The file itself lives under ./secrets/ (gitignored) and is mounted read-only
#   at /app/secrets — so the default below is correct as long as the file is
#   named gcp-service-account.json.
WORKSPACE_DOMAIN=
SYNCED_MAILBOXES=
INTERNAL_EMAILS_OR_DOMAINS=
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/gcp-service-account.json

# --- Gmail Pub/Sub push ---
# PUBSUB_TOPIC — full topic name, e.g. projects/PROJECT_ID/topics/gmail-events.
# PUBSUB_AUDIENCE — REQUIRED when PUBSUB_TOPIC is set (startup check in main.py).
#   Must match the audience configured on the GCP push subscription — typically
#   the public endpoint URL, e.g. https://hub.<your-domain>/webhooks/gmail.
# PUBSUB_SERVICE_ACCOUNT_EMAIL — the SA that signs the push JWTs (chosen when
#   creating the push subscription). Used to validate the iss/email claim.
PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=


# --- Cloudflare tunnel ---
# Consumed by docker-compose's cloudflared service. The token from the Zero
# Trust dashboard when you create the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=


# --- Notion ---
# NOTION_TOKEN — internal-integration secret (starts with `secret_` / `ntn_`).
# EMAILS_PARENT_PAGE_ID — parent PAGE under which yearly `Emails YYYY` DBs are
#   auto-created (NOT a DB id — a page id).
# CONTACTS_DB_ID / COMPANIES_DB_ID / PROJECTS_DB_ID — the three core DB ids.
# NOTION_WEBHOOK_SECRET — shared bearer secret. Set it as the Authorization
#   header value on EVERY Notion button/automation that POSTs to this backend
#   (send-faktura, graduate-faktura, oppgave-done, etc.).
NOTION_TOKEN=
NOTION_API_VERSION=2022-06-28
EMAILS_PARENT_PAGE_ID=
CONTACTS_DB_ID=
COMPANIES_DB_ID=
PROJECTS_DB_ID=
NOTION_WEBHOOK_SECRET=


# --- Sync queue visibility (both optional; the Postgres queue works regardless) ---
# PROJECTS_SYNC_STATUS: write a sync-status icon (🔄/⚠️/🛑/✅) onto each Projects DB
# page via a "Sync" Select property. Requires that property to exist on the DB
# (the icon options auto-create on first write). Off by default.
PROJECTS_SYNC_STATUS=false
# SYNC_QUEUE_DB_ID: optional Notion DB that mirrors the live queue (queued /
# processing / failed) for the client to watch. The Postgres `sync_tasks` table
# is the source of truth; this is observer-only. Empty = skip the mirror.
# Property names live in config.py SYNC_QUEUE_PROPS.
SYNC_QUEUE_DB_ID=


# --- Project provisioning fan-out (one Notion button → many targets) ---
# Each target is independently togglable. Set SYNC_GMAIL_LABELS=false to test
# other steps without churning Gmail labels.
SYNC_GMAIL_LABELS=true


# --- Office NAS (shared W: drive) — see docs/misc/nas-setup.md ---
# Off by default. Docker mounts the share itself via CIFS — no Windows-side
# drive-letter mapping needed (and on Windows Docker Desktop WSL2 backend,
# mapped drives don't work as bind sources anyway, see docs/misc/gotchas.md §15).
# In prod the CIFS volume is bound via docker-compose.prod.yml.
SYNC_NAS_FOLDERS=false
# NAS_CIFS_DEVICE — UNC path with FORWARD slashes (Docker requirement), no
# leading smb://. e.g. //192.168.1.200/filserver/gb-automations-test for the
# test sub-folder, then //192.168.1.200/filserver/Prosjekt for live.
NAS_CIFS_DEVICE=
NAS_USER=
NAS_PASS=
# NAS_HOST_PATH — Windows-facing display path written into Notion's "NAS"
# URL column on each project (so the team can click and open in Explorer).
# Cosmetic only: NOT used to mount anything. Match the Windows-side path the
# team uses, e.g. "W:\gb-automations-test" or "W:\Prosjekt".
# Empty → no Notion writeback (folders still get created).
NAS_HOST_PATH=
NAS_PROJECTS_ROOT=/mnt/nas/Prosjekt
NAS_RECEIVED_SUBFOLDER=Mottatt


# --- Frame.io (V4, OAuth Web App via Adobe IMS) — see docs/misc/frame-setup.md ---
# Off by default. Flip SYNC_FRAME=true ONLY after the OAuth bootstrap has run
# (`python -m gb_automations.scripts.frame_oauth_bootstrap`) and the four
# required fields (refresh token, account id, workspace id, placeholder url) are
# filled — main.py fails loudly at boot otherwise.
SYNC_FRAME=false
# OAuth app credentials from the Adobe Developer Console project.
FRAME_CLIENT_ID=
FRAME_CLIENT_SECRET=
# Redirect URI registered in Adobe Developer Console — MUST match exactly.
# Lives under the public hub domain (Adobe requires HTTPS), e.g.
# https://hub.<your-domain>/oauth/frame/callback
FRAME_REDIRECT_URI=
# Written by the bootstrap script after the one-time OAuth consent. Long-lived
# under offline_access; re-run the bootstrap if the Adobe password/credential
# is rotated.
FRAME_REFRESH_TOKEN=
# Account + workspace the integration writes into. Resolved + printed by the
# bootstrap script. Each Notion project becomes a top-level Frame project here.
FRAME_ACCOUNT_ID=
FRAME_WORKSPACE_ID=
# HMAC signing secret returned when the webhook is created (register via
# `python -m gb_automations.scripts.frame_register_webhook`). Used to verify
# inbound Frame webhooks.
FRAME_WEBHOOK_SECRET=
# Workspace UUID of Frame's custom "Status" select field (surfaced at
# GET /debug/frame/field-definitions). Empty → the Notion↔Frame status
# reconcile is disabled (skips cleanly, no crash).
FRAME_STATUS_FIELD_ID=
# Publicly-fetchable placeholder image Frame's create_file_from_url GETs to seed
# each deliverable's V00 asset. Point at the app's own asset URL over the tunnel,
# e.g. https://hub.<your-domain>/assets/Goldbox_Logo_White.png — the dynamic
# per-deliverable render origin is derived from this host automatically.
FRAME_PLACEHOLDER_URL=
# Studio identifier baked into placeholder filenames (<project>_<studio>_..._V00).
FRAME_FILENAME_STUDIO=Goldbox.no
# Notion DB ids for the Frame integration (see docs/notion-db-names.md):
#   OPPGAVER_DB_ID     — deliverables + internal tasks + Korreksjonsrunde rows.
#   KORREKSJONER_DB_ID — individual feedback items (one row per Frame comment).
# OPPGAVER_DB_ID also accepts the legacy names LEVERANSER_DB_ID / TASKS_DB_ID.
OPPGAVER_DB_ID=
KORREKSJONER_DB_ID=


# --- Toggl Track (timesheet integration) — see CLAUDE.md Toggl section ---
# Off by default. SYNC_TOGGL mirrors projects to Toggl on the Notion Initialize
# button; SYNC_TOGGL_HOURS is the independent nightly hours→Notion aggregation.
SYNC_TOGGL=false
SYNC_TOGGL_HOURS=false
# Single workspace-ADMIN API token (Reports v3 returns every member's entries
# for an admin token, so no per-user setup). From track.toggl.com/profile.
TOGGL_API_TOKEN=
# Resolved + printed by the Toggl bootstrap script.
TOGGL_WORKSPACE_ID=
# Parent PAGE under which yearly `Timer YYYY` DBs are auto-created (page id,
# same pattern as EMAILS_PARENT_PAGE_ID). Needed only when SYNC_TOGGL_HOURS=true.
TOGGL_TIMER_PARENT_PAGE_ID=
# How many days back the nightly hours run re-pulls + overwrites. 32 covers the
# full current month so retroactive timesheet edits always propagate.
TOGGL_HOURS_WINDOW_DAYS=32
# DEV-ONLY email remap for when your personal Toggl + Notion accounts don't
# share an email. Comma-separated `toggl_email=notion_email` pairs. Leave BLANK
# in production (Goldbox accounts share the same email). Example:
#   TOGGL_DEV_EMAIL_OVERRIDES=tobias@example.com=tobias@my-notion.com
TOGGL_DEV_EMAIL_OVERRIDES=


# --- Fiken (Norwegian accounting) — see docs/misc/fiken-integration.md ---
# Off by default. Flip SYNC_FIKEN=true only after the personal-account smoke
# test passes; main.py then requires FIKEN_API_TOKEN + FIKEN_COMPANY_SLUG +
# PROJECTS_DB_ID at boot.
SYNC_FIKEN=false
# Non-expiring personal API token: Fiken → Rediger konto → Sikkerhet →
# Personlige API-nøkler.
FIKEN_API_TOKEN=
# Company slug from GET /companies. Every endpoint is scoped /companies/{slug}/.
FIKEN_COMPANY_SLUG=
# The single Notion `Faktura` DB the graduation/poller writes sent invoices +
# credit notes into. Empty → the Faktura DB writer no-ops (engine logs + skips).
FAKTURA_DB_ID=
# Notion `Fakturamottaker` (billing-recipient) DB. Empty → the Brreg-by-name
# customer writeback is disabled (engine falls back to the "Mangler kunde"
# placeholder); the Brreg-by-orgnr title enrichment still works.
FAKTURAMOTTAKER_DB_ID=
# C.3b hourly graduation poller. When true, an APScheduler cron enqueues a
# graduate_faktura task per active-Faktura-status project every hour (replaces
# the operator clicking "Sjekk fiken" after every sent invoice).
SYNC_FIKEN_GRADUATIONS=false
# Display name for the auto-created Fiken contact a draft is linked to when the
# project's Fakturamottaker has no Orgnr. Operator picks the real customer in
# Fiken before sending.
FIKEN_PLACEHOLDER_CONTACT_NAME=Mangler kunde
# Optional override for the Kontonummer (bankAccountNumber) printed on drafts.
# Empty → engine auto-picks the first active normal-type account and caches it.
# Format matches Fiken's UI: "36061538997" (no spaces, no IBAN).
FIKEN_BANK_ACCOUNT_NUMBER=
# Optional overrides for the top-of-invoice Kommentar text (Fiken invoiceText),
# one per mode. Leave commented to keep the built-in Norwegian defaults; set to
# an empty value to omit the field entirely (Fiken uses its company default).
# Engine reads these live each run — edit without redeploying.
# FIKEN_INVOICE_TEXT_OPPSTART=
# FIKEN_INVOICE_TEXT_SLUTT=
# Legacy poller knobs (used only by the Phase C poller path). Defaults are fine.
FIKEN_POLL_INTERVAL_MINUTES=30
FIKEN_FIRST_POLL_WINDOW_DAYS=90
