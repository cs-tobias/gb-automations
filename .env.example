# gb-automations — copy to .env, fill in the blanks.
# Guides:
#   docs/google-setup.md  docs/cloudflare-setup.md  docs/notion-setup.md

# --- Stack basics (leave as-is) ---
ENV=dev
LOG_LEVEL=INFO
POSTGRES_USER=gb
POSTGRES_PASSWORD=gb
POSTGRES_DB=gb
DATABASE_URL=postgresql+asyncpg://gb:gb@db:5432/gb

# --- LLM ---
# OLLAMA_BASE_URL: where the api talks to Ollama.
#   http://ollama:11434              → default. In-container Ollama service
#                                      (Windows, Linux, Mac without native
#                                      install). The api auto-pulls the model
#                                      on first boot.
#   http://host.docker.internal:11434 → Mac dev opt-out for Metal acceleration.
#                                      Requires `OLLAMA_HOST=0.0.0.0:11434
#                                      ollama serve` natively, plus
#                                      `docker compose stop ollama` so the
#                                      unused in-container service doesn't
#                                      waste ~5GB disk + idle RAM.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT_S=30.0
TAGGING_ENABLED=true
TAGGING_PROMPT_PATH=prompts/default.md

# ----------- Fill In -------------- #

# --- Workspac + Gmail Pub/Sub push ---
WORKSPACE_DOMAIN=
INTERNAL_EMAILS_OR_DOMAINS=
PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/gcp-service-account.json


# --- Cloudflare tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=


# --- Notion ---
NOTION_TOKEN=
NOTION_API_VERSION=2022-06-28
EMAILS_PARENT_PAGE_ID=
CONTACTS_DB_ID=
COMPANIES_DB_ID=
PROJECTS_DB_ID=
NOTION_WEBHOOK_SECRET=