# [LEAVE AS-IS] Environment name. Only matters for logs and the /health endpoint.
ENV=dev

# [LEAVE AS-IS] Flip to DEBUG when sync misbehaves and you need to see every outbound API call. 
LOG_LEVEL=INFO

# [LEAVE AS-IS] Postgres user / password / db. The db container creates this
# user on first boot; the api container connects with the same creds below.
POSTGRES_USER=gb
POSTGRES_PASSWORD=gb
POSTGRES_DB=gb

# [LEAVE AS-IS] Connection string for the api container.
DATABASE_URL=postgresql+asyncpg://gb:gb@db:5432/gb



# STEP 1 — Google Workspace + service account  (setup.md §1-3)
# After: GCP project created, service account JSON downloaded to
# secrets/gcp-service-account.json, domain-wide delegation authorized.

# [FILL IN] Your Workspace domain (the part after the @ in your user emails).
#   Example: goldbox.no
WORKSPACE_DOMAIN=example.com

# [LEAVE AS-IS] Path INSIDE the api container. The host path
# `secrets/gcp-service-account.json` is mounted to `/app/secrets/` read-only
# by docker-compose. Don't change unless you also change the compose mount.
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/gcp-service-account.json

# [OPTIONAL] Comma-separated internal emails or bare domains. Used to classify
# the Goldbox Role select on each email row (Sender / Recipient / Internal /
# External) AND to drive the LLM tagging prompt's sender-role hint.
#
# When empty, falls back to `WORKSPACE_DOMAIN` above — so a single-domain
# setup (just `WORKSPACE_DOMAIN=goldbox.no`) Just Works without setting this.
# Set this only when you need overrides: e.g. a consultant on a different
# domain who should still count as internal, or specific team aliases.
#   Simple form:     goldbox.no
#   With overrides:  tobias@goldbox.no, post@goldbox.no, goldbox.no
INTERNAL_EMAILS_OR_DOMAINS=


# =============================================================================
# STEP 3 — Notion integration  (setup.md §4)
# =============================================================================
# After: Notion integration created and shared with the Emails / Contacts /
# Projects databases. You'll fill the DB IDs in STEP 5 after first boot.

# [FILL IN] Notion integration secret. Starts with `ntn_`.
# Get from: https://www.notion.so/profile/integrations → your integration
NOTION_TOKEN=

# [LEAVE AS-IS] Notion API version. Don't bump without testing.
NOTION_API_VERSION=2022-06-28


# =============================================================================
# STEP 4 — Cloudflare Tunnel  (setup.md §5)
# =============================================================================
# After: Cloudflare zone added, tunnel created with hostname `hub.{domain}`
# routed to `api:8000`.

# [FILL IN] Cloudflare Tunnel token. Long string starting with `eyJ...`.
# Get from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel
# Leave empty to disable the cloudflared service (purely-local dev only).
CLOUDFLARE_TUNNEL_TOKEN=


# =============================================================================
# STEP 5 — Notion IDs + webhook  (setup.md §9-10, AFTER first boot)
# =============================================================================
# These steps happen AFTER the stack is up the first time:
#
#   1. Bring up the stack:  docker compose up -d --build
#   2. Fetch IDs:           curl https://hub.{your-domain}/debug/databases
#   3. Paste IDs below      (EMAILS_PARENT_PAGE_ID, CONTACTS_DB_ID, PROJECTS_DB_ID)
#   4. Register webhook in Notion → it sends a verification token
#   5. Paste that token as NOTION_WEBHOOK_SECRET below
#   6. Reload:              docker compose up -d --force-recreate api
#
# Until then, leave these blank.

# [FILL IN AFTER FIRST BOOT] The Notion PAGE under which year-partitioned
# `Emails YYYY` databases live. The app auto-creates each year's DB on first
# email of that year — you only configure the parent page once. At Goldbox
# volume (~7k emails/year) a single DB starts to slow down past year 3; year
# partitioning keeps every DB fresh while threads stay continuous via the
# `Thread ID` text property.
EMAILS_PARENT_PAGE_ID=

# [FILL IN AFTER FIRST BOOT] Contacts is a single DB (people don't expire
# annually) shared across all year Emails DBs via the From/To/Cc relations.
CONTACTS_DB_ID=

# [OPTIONAL] If set, the Notion webhook only acts on pages parented to this
# specific database. Empty = act on every page.created event the integration
# sees (noisier but simpler).
PROJECTS_DB_ID=

# [FILL IN AFTER FIRST BOOT] Notion webhook verification token. After
# registering the webhook in Notion, the first inbound POST logs the
# `secret_…` token — paste it here and into Notion's "Verification token"
# field. Enables HMAC signature checking on every webhook.
NOTION_WEBHOOK_SECRET=


# =============================================================================
# STEP 6 — Gmail Pub/Sub push  (setup.md §6)
# =============================================================================
# After: GCP Pub/Sub topic created, push subscription created with endpoint
# `https://hub.{your-domain}/webhooks/gmail`.
#
# NOTE: PUBSUB_AUDIENCE must EXACTLY match the audience configured on the
# push subscription in GCP. If left empty while PUBSUB_TOPIC is set, the
# app refuses to start (intentional: silent audience mismatches would
# otherwise reject every Gmail push for weeks before anyone notices).

# [FILL IN] Full Pub/Sub topic name.
#   Example: projects/goldbox-gb-automations-prod/topics/gmail-events
PUBSUB_TOPIC=

# [FILL IN] Audience claim — the push endpoint URL on your domain.
#   Example: https://hub.goldbox.no/webhooks/gmail
PUBSUB_AUDIENCE=

# [FILL IN] Service account email chosen when creating the push subscription
# (used to verify the JWT signer). Usually the same SA as in STEP 2.
#   Example: gb-automations-sync@goldbox-gb-automations-prod.iam.gserviceaccount.com
PUBSUB_SERVICE_ACCOUNT_EMAIL=


# =============================================================================
# STEP 7 — Local LLM (Ollama) for email tagging  (setup.md §11b)
# =============================================================================
# Runs in the `ollama` compose service. Pull the model once after first boot:
#   docker compose exec api python -m gb_automations.scripts.pull_llm_model

# [LEAVE AS-IS] Ollama URL. The `ollama` hostname resolves to the compose
# service. Only override for non-container Ollama on Mac dev:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# [LEAVE AS-IS] Model identifier. ~5GB download on first pull.
# Change only if you've tested a different model with the tagging prompt.
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# [LEAVE AS-IS] Per-chunk timeout. 30s covers cold model load.
OLLAMA_TIMEOUT_S=30.0

# [LEAVE AS-IS] Master switch for LLM tagging. Adds ~1-2s per Notion row.
# Set to false to disable tagging entirely (Tags column stays empty).
TAGGING_ENABLED=true

# [OPTIONAL] Path to the markdown file with the tagging system prompt.
# Relative paths resolve from the project root (Windows + Mac safe).
#   prompts/default.md  — generic English fallback
#   prompts/goldbox.md  — Norwegian Goldbox-specific
# Add your own at prompts/{client}.md and point this at it.
TAGGING_PROMPT_PATH=prompts/default.md
