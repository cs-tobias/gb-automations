# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
.venv-test/
venv/
env/

# uv
# (uv.lock IS committed)

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Environments
.env
.env.local
.env.*.local

# Installer state (written by `python -m gb_automations.scripts.setup_workspace`)
.setup_state.json
.setup_state.json.corrupt

# Secrets (service account JSON, etc.) — never commit
secrets/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Claude Code — per-machine local state (personal paths + one-off permission
# grants). A shared .claude/settings.json (if ever added) stays trackable.
.claude/settings.local.json

# Docker
# (compose.override.yml is gitignored so devs can override locally)
docker-compose.override.yml
docker-compose.override.yaml

# Alembic — keep migrations/versions/, ignore __pycache__ within
migrations/__pycache__/
migrations/versions/__pycache__/
